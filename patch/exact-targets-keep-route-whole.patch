+# The runtime resamples the route at 80/19 m from the ego's projection and drops the points under 40 m.
+_SERVED_ROUTE_START_ARC_M = 10 * 80 / 19
+
+
+def _exact_route_target_poses(
+    served_xy: jt.Float64[npt.NDArray[np.float64], "num_served 2"],
+    target_point_distances_m: list[float],
+) -> jt.Float64[npt.NDArray[np.float64], "num_points 3"] | None:
+    """
+    Places target points at their arc distance from the ego along the served route, whose start is 42.105 m of arc ahead.
+
+    Args:
+        served_xy: the route the runtime serves now, in the local frame.
+        target_point_distances_m: the arc-length distances of the target points from the ego.
+
+    Returns:
+        (x, y, route heading) per target point in the local frame, NaN past the route's end; None when the route's
+        first spacing is not the runtime's, so the walked target points stay.
+    """
+    if len(served_xy) < 2:
+        return None
+    steps_m = np.linalg.norm(np.diff(served_xy, axis=0), axis=1)
+    if not 3.0 <= steps_m[0] <= 5.0:
+        return None
+    arc_m = np.concatenate([[0.0], np.cumsum(steps_m)])
+    first_heading = math.atan2(served_xy[1, 1] - served_xy[0, 1], served_xy[1, 0] - served_xy[0, 0])
+    # Turn per segment from the first two segments, for the stretch short of route[0] the runtime withholds.
+    turn_per_m = 0.0
+    if len(served_xy) >= 3 and steps_m[1] > 0.0:
+        second_heading = math.atan2(served_xy[2, 1] - served_xy[1, 1], served_xy[2, 0] - served_xy[1, 0])
+        turn_per_m = math.remainder(second_heading - first_heading, math.tau) / (0.5 * (steps_m[0] + steps_m[1]))
+    poses = np.full((len(target_point_distances_m), 3), np.nan, dtype=np.float64)
+    for index, distance_m in enumerate(target_point_distances_m):
+        past_start_m = distance_m - _SERVED_ROUTE_START_ARC_M
+        if past_start_m > arc_m[-1]:
+            continue
+        if past_start_m <= 0.0:
+            # Short of route[0]: back along the first segment's curvature (its heading holds at its midpoint).
+            chord_heading = first_heading + turn_per_m * (0.5 * past_start_m - 0.5 * steps_m[0])
+            poses[index, :2] = served_xy[0] + past_start_m * np.array([math.cos(chord_heading), math.sin(chord_heading)])
+            poses[index, 2] = first_heading + turn_per_m * (past_start_m - 0.5 - 0.5 * steps_m[0])
+            continue
+        # The heading looks back 1 m, as for the trained target points.
+        heading_from_m = max(past_start_m - 1.0, 0.0)
+        heading_to_m = max(past_start_m, heading_from_m + 1.0)
+        at = [np.interp([past_start_m, heading_from_m, heading_to_m], arc_m, served_xy[:, axis]) for axis in range(2)]
+        poses[index, :2] = at[0][0], at[1][0]
+        poses[index, 2] = math.atan2(at[1][2] - at[1][1], at[0][2] - at[0][1])
+    return poses
+
